{
  "name": "completionist-log",
  "version": "0.5.0",
  "private": true,
  "description": "FFXIV completionist tracker for Android (Capacitor)",
  "scripts": {
    "sync": "cap sync android",
    "icons": "capacitor-assets generate --android --iconBackgroundColor '#10131f' --iconBackgroundColorDark '#10131f' --splashBackgroundColor '#10131f' --splashBackgroundColorDark '#10131f'",
    "open": "cap open android",
    "build:debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "build:release": "cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0"
  }
}
